PORT=5000
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# AI Service (OpenRouter - recommended, FREE credits available)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# AI Service (Gemini - FREE alternative)
GEMINI_API_KEY=

# AI Service (OpenAI - Fallback)
OPENAI_API_KEY=

# Telegram Bot (optional - for Telegram integration)
TELEGRAM_BOT_TOKEN=

# Gmail (optional - for email integration)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# WhatsApp (optional)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Frontend URL (for CORS)
FRONTEND_URL=https://your-web-app.vercel.app
